		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.3",
		"svelte-preprocess": "^6.0.5",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^4.1.10"
